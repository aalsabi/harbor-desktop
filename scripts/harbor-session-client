#!/usr/bin/python3
"""Run Harbor without the Plasma workspace startup. Own only spawned children."""

import os, pathlib, runpy, shutil, signal, subprocess, sys, time

if os.getenv('HARBOR_USER_CONFIG'):
    os.environ['XDG_CONFIG_HOME'] = os.environ['HARBOR_USER_CONFIG']
locale_applied = runpy.run_path(str(pathlib.Path(__file__).with_name('harbor-locale-environment')))[
    'apply_locale_environment'
](os.environ)
os.environ.setdefault('QT_ACCESSIBILITY', '1')
children = []
stopping = False


def stop(signum, frame):
    global stopping
    stopping = True
    for child in children:
        if child.poll() is None:
            child.terminate()


for sig in (signal.SIGTERM, signal.SIGINT):
    signal.signal(sig, stop)
# KWin supplies the actual display names to this client. Publish them only
# after restoring application configuration, before launching any clients.
# A nested/private bus must never overwrite the host systemd user environment.
activation_keys = (
    'WAYLAND_DISPLAY',
    'DISPLAY',
    'XAUTHORITY',
    'XDG_CURRENT_DESKTOP',
    'XDG_SESSION_DESKTOP',
    'XDG_SESSION_TYPE',
    'XDG_MENU_PREFIX',
    'XDG_CONFIG_HOME',
    'XDG_DATA_HOME',
    'XDG_CACHE_HOME',
    'XDG_STATE_HOME',
    'QT_ACCESSIBILITY',
    'LANG',
    'LANGUAGE',
    'LC_ALL',
    'LC_CTYPE',
    'LC_COLLATE',
    'LC_MESSAGES',
    'LC_TIME',
    'LC_NUMERIC',
    'LC_MONETARY',
    'LC_MEASUREMENT',
    'LC_PAPER',
    'LC_NAME',
    'LC_ADDRESS',
    'LC_TELEPHONE',
    'LC_IDENTIFICATION',
)
activation_command = ['dbus-update-activation-environment']
if not os.getenv('HARBOR_PRIVATE_BUS'):
    activation_command.append('--systemd')
activation_command.extend(key for key in activation_keys if key in os.environ)
# D-Bus activation has no unset operation. Empty LC_ALL has the same locale
# precedence as an absent value and clears an override from a previous session.
if locale_applied:
    activation_command.append('LC_ALL=')
try:
    subprocess.run(activation_command, check=True, timeout=3)
except (OSError, subprocess.SubprocessError) as error:
    print(f'Harbor: could not synchronize application activation environment: {error}', file=sys.stderr)
# Authentication is supplied by a packaged agent, not an elevated shell.
for candidate in [
    '/usr/lib/x86_64-linux-gnu/libexec/polkit-kde-authentication-agent-1',
    '/usr/lib/polkit-kde-authentication-agent-1',
    '/usr/libexec/polkit-gnome-authentication-agent-1',
]:
    if os.path.isfile(candidate):
        children.append(subprocess.Popen([candidate]))
        break
# Session services own their spawned children and stop with this session.
for service in ('harbor-power-agent', 'harbor-accessibility-agent'):
    if shutil.which(service):
        children.append(subprocess.Popen([service]))
code = 1
try:
    for attempt in range(3):
        if stopping:
            break
        shell = subprocess.Popen(['harbor-shell'])
        children.append(shell)
        if attempt == 0 and shutil.which('harbor-autostart'):
            children.append(subprocess.Popen(['harbor-autostart']))
        code = shell.wait()
        if code == 0 or stopping:
            break
        time.sleep(1)
finally:
    stop(None, None)
    for child in children:
        try:
            child.wait(
                timeout={"harbor-accessibility-agent": 20, "harbor-power-agent": 10}.get(child.args[0], 4)
            )
        except subprocess.TimeoutExpired:
            child.kill()
            child.wait()
sys.exit(code)
