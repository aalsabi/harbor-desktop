#!/usr/bin/python3
"""Import a VPN in memory, restrict it to this user, then save through libnm.

No secret data is accepted on the command line or emitted to stdout/stderr.
"""
import os
import pathlib
import pwd
import sys


def prepare_connection(kind, path, NM, user):
    source = pathlib.Path(path)
    if kind not in ('openvpn', 'wireguard') or not source.is_absolute() or not source.is_file():
        raise ValueError('Select a local OpenVPN or WireGuard configuration file.')
    if source.stat().st_size > 5 * 1024 * 1024 or not os.access(source, os.R_OK):
        raise ValueError('The configuration must be readable and at most 5 MB.')
    if not user:
        raise ValueError('Could not determine the current user.')
    if kind == 'wireguard':
        connection = NM.conn_wireguard_import(str(source))
    else:
        plugin = next((item for item in NM.VpnPluginInfo.list_load()
                       if item.get_service() == 'org.freedesktop.NetworkManager.openvpn'), None)
        if plugin is None:
            raise ValueError('Install the NetworkManager OpenVPN import plugin.')
        connection = plugin.load_editor_plugin().import_(str(source))
    if connection is None:
        raise ValueError('The VPN configuration could not be imported.')
    setting = connection.get_setting_connection()
    if setting is None:
        raise ValueError('The imported configuration has no connection settings.')
    # No temporary NetworkManager profile exists before these restrictions.
    setting.set_property('permissions', [])
    if not setting.add_permission('user', user, None):
        raise ValueError('Could not restrict the connection to the current user.')
    setting.set_property('autoconnect', False)
    connection.verify()
    return connection


def main():
    if len(sys.argv) != 3:
        print('Expected VPN type and local configuration path.', file=sys.stderr)
        return 1
    try:
        import gi
        gi.require_version('NM', '1.0')
        from gi.repository import NM, GLib, Gio
        connection = prepare_connection(sys.argv[1], sys.argv[2], NM, pwd.getpwuid(os.getuid()).pw_name)
        client = NM.Client.new(None)
        loop = GLib.MainLoop()
        cancellation = Gio.Cancellable()
        outcome = {'ok': False}
        def finished(client, result, _data):
            try:
                outcome['ok'] = client.add_connection_finish(result) is not None
            except Exception:
                pass
            loop.quit()
        def timeout():
            cancellation.cancel()
            loop.quit()
            return False
        client.add_connection_async(connection, True, cancellation, finished, None)
        timer = GLib.timeout_add_seconds(30, timeout)
        loop.run()
        if outcome['ok']:
            GLib.source_remove(timer)
            print('Imported')
            return 0
    except (ImportError, AttributeError):
        print('Install python3-gi, gir1.2-nm-1.0, and the matching NetworkManager VPN plugin.', file=sys.stderr)
        return 1
    except ValueError as error:
        print(str(error), file=sys.stderr)
        return 1
    except Exception:
        pass
    # Plugin errors may include configuration contents. Never relay them.
    print('VPN import failed. Check the configuration, plugin, and NetworkManager authorization.', file=sys.stderr)
    return 1


if __name__ == '__main__':
    sys.exit(main())
