#!/usr/bin/python3
"""Apply a validated display layout and independently roll it back after 15 seconds."""
import argparse,fcntl,json,math,pathlib,signal,subprocess,sys,time

def run(args):
 return subprocess.run(['kscreen-doctor',*args],capture_output=True,text=True,check=True,timeout=8).stdout

def main():
 p=argparse.ArgumentParser();p.add_argument('--directory',required=True);p.add_argument('--layout',required=True);p.add_argument('--timeout',type=int,default=15);a=p.parse_args()
 change=json.loads(a.layout)
 if not isinstance(change,dict) or set(change)-{'id','x','y','scale','mode','primary'}:raise ValueError('Invalid layout fields')
 for key in ('id','x','y'):
  if type(change.get(key)) is not int or not 0<=change[key]<=32768:raise ValueError('Invalid output or position')
 if type(change.get('scale')) not in (int,float) or not math.isfinite(change['scale']) or not .5<=change['scale']<=4:raise ValueError('Invalid scale')
 if type(change.get('mode')) is not str or type(change.get('primary')) is not bool or not 1<=a.timeout<=30:raise ValueError('Invalid mode or primary output')
 folder=pathlib.Path(a.directory);folder.mkdir(mode=0o700,parents=True,exist_ok=False)
 def status(state,error=''):
  tmp=folder/'status.tmp';tmp.write_text(json.dumps({'status':state,'error':error}));tmp.replace(folder/'status.json')
 lock=open(folder.parent/'display.lock','a')
 try:fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
 except BlockingIOError:status('failed','Another display transaction is active');return 1
 original=[];applied=False;stop=False;failure=''
 def interrupt(*args):
  nonlocal stop
  stop=True
 signal.signal(signal.SIGTERM,interrupt);signal.signal(signal.SIGINT,interrupt)
 try:
  original=[o for o in json.loads(run(['-j']))['outputs'] if o['connected'] and o['enabled']]
  target=next(o for o in original if o['id']==change['id'])
  if change['mode'] not in [str(m['id']) for m in target['modes']]:raise ValueError('Mode is no longer available')
  prefix='output.'+str(change['id'])
  args=[prefix+'.position.'+str(change['x'])+','+str(change['y']),prefix+'.scale.'+str(change['scale']),prefix+'.mode.'+change['mode']]
  if change['primary']:args.append(prefix+'.primary')
  applied=True;run(args)
  actual=next(o for o in json.loads(run(['-j']))['outputs'] if o['id']==change['id'])
  if actual['pos']!={'x':change['x'],'y':change['y']} or abs(float(actual['scale'])-change['scale'])>.01 or str(actual['currentModeId'])!=change['mode'] or (change['primary'] and actual.get('priority')!=1):raise ValueError('The display server did not accept this layout')
  status('pending');deadline=time.monotonic()+a.timeout
  while time.monotonic()<deadline and not stop:
   if (folder/'confirm').exists():status('confirmed');applied=False;break
   if (folder/'revert').exists():break
   time.sleep(.1)
 except Exception as error:
  failure=str(error)
  if not applied:status('failed',failure)
 finally:
  if applied and original:
   try:
    live={o['id'] for o in json.loads(run(['-j']))['outputs'] if o['connected']}
    args=[]
    for o in original:
     if o['id'] not in live:continue
     pre='output.'+str(o['id']);args.extend([pre+'.position.'+str(o['pos']['x'])+','+str(o['pos']['y']),pre+'.scale.'+str(o['scale']),pre+'.mode.'+str(o['currentModeId'])])
     if o.get('priority',0)>0:args.append(pre+'.priority.'+str(o['priority']))
    if args:run(args)
    restored={o['id']:o for o in json.loads(run(['-j']))['outputs'] if o['connected']}
    for before in original:
     if before['id'] not in restored:continue  # An unplugged output cannot be restored.
     after=restored[before['id']]
     if not after.get('enabled') or after['pos']!=before['pos'] or not math.isclose(float(after['scale']),float(before['scale']),abs_tol=.01,rel_tol=0) or str(after['currentModeId'])!=str(before['currentModeId']) or after.get('priority')!=before.get('priority'):
      raise ValueError('Display '+str(before['id'])+' did not restore its original position, scale, mode and priority')
    status('reverted',failure)
   except Exception as error:status('rollback-failed',str(error))
 return 0
if __name__=='__main__':
 try:sys.exit(main())
 except Exception as error:sys.exit(str(error))
